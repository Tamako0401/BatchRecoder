<Window x:Class="BatchRecoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BatchRecoder.ViewModels"
        xmlns:models="clr-namespace:BatchRecoder.Models"
        mc:Ignorable="d"
        Title="BatchRecoder" Height="600" Width="1000">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- 顶部：目录选择与控制 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="目标目录:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="扫描" Command="{Binding ScanCommand}" Width="80" Margin="0,0,10,0" />
            <Button Grid.Column="3" Content="开始处理" Command="{Binding StartCommand}" Width="80" Margin="0,0,10,0" />
            <Button Grid.Column="4" Content="停止" Command="{Binding StopCommand}" Width="80" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="暂停" Command="{Binding PauseCommand}" Width="80" Margin="0,0,10,0" />
                <Button Content="继续" Command="{Binding ResumeCommand}" Width="80" />
            </StackPanel>
        </Grid>

        <!-- 中间：文件列表与参数设置 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 文件列表 -->
            <GroupBox Header="文件列表" Grid.Column="0">
                <DataGrid ItemsSource="{Binding VideoFiles}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          VerticalGridLinesBrush="Transparent"
                          AlternatingRowBackground="#FAFAFA"
                          RowBackground="White"
                          HeadersVisibility="Column"
                          BorderThickness="1"
                          BorderBrush="#EEEEEE">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" />
                        <DataGridTemplateColumn Header="状态" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColor}"
                                               FontWeight="Bold" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="进度" Binding="{Binding Progress, StringFormat={}{0:F1}%}" Width="Auto" />
                        <DataGridTextColumn Header="分辨率" Binding="{Binding ResolutionDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="帧率" Binding="{Binding FrameRateDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="码率" Binding="{Binding VideoBitrateDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="时长" Binding="{Binding DurationDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="大小" Binding="{Binding FileSizeDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="剩余时间" Binding="{Binding Eta}" Width="Auto" />
                        <DataGridTemplateColumn Header="操作" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="重试"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding Status, Converter={StaticResource FailedToVisibleConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <!-- 参数设置 -->
            <GroupBox Header="编码参数" Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <TextBlock Text="视频编码器:" Margin="0,5,0,2" />
                        <ComboBox ItemsSource="{Binding VideoEncoders}"
                                  SelectedItem="{Binding Settings.VideoEncoder}" />

                        <TextBlock Text="目标分辨率:" Margin="0,10,0,2" />
                        <ComboBox ItemsSource="{Binding TargetResolutions}"
                                  SelectedItem="{Binding Settings.TargetResolution}" />

                        <StackPanel Visibility="{Binding Settings.IsCustomResolution, Converter={StaticResource BooleanToVisibleConverter}}" Margin="10,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="宽度:" Margin="0,5,0,2" />
                                    <TextBox Text="{Binding Settings.CustomWidth}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="高度:" Margin="0,5,0,2" />
                                    <TextBox Text="{Binding Settings.CustomHeight}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="CRF (0-51):" Margin="0,10,0,2" />
                        <Grid>
                            <Slider Minimum="0" Maximum="51" Value="{Binding Settings.Crf}" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,0,40,0" />
                            <TextBlock Text="{Binding Settings.Crf}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Width="30" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Text="预设 (Preset):" Margin="0,10,0,2" />
                        <ComboBox ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding Settings.Preset}" />

                        <TextBlock Text="配置 (Profile):" Margin="0,10,0,2" />
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding Settings.Profile}" />

                        <TextBlock Text="调整 (Tune):" Margin="0,10,0,2" />
                        <ComboBox ItemsSource="{Binding Tunes}"
                                  SelectedItem="{Binding Settings.Tune}" />

                        <TextBlock Text="音频编码器:" Margin="0,10,0,2" />
                        <ComboBox ItemsSource="{Binding AudioEncoders}"
                                  SelectedItem="{Binding Settings.AudioEncoder}" />

                        <TextBlock Text="音频码率 (kbps):" Margin="0,10,0,2" />
                        <ComboBox ItemsSource="{Binding AudioBitrates}"
                                  SelectedItem="{Binding Settings.AudioBitrate}" />

                        <CheckBox Content="复制音频流 (不重新编码)" IsChecked="{Binding Settings.CopyAudio}" Margin="0,10,0,0" />

                        <TextBlock Text="输出格式:" Margin="0,10,0,2" />
                        <ComboBox ItemsSource="{Binding OutputFormats}"
                                  SelectedItem="{Binding Settings.OutputFormat}" />

                        <TextBlock Text="额外参数:" Margin="0,10,0,2" />
                        <TextBox Text="{Binding Settings.ExtraArgs}" Height="60" TextWrapping="Wrap"
                                 AcceptsReturn="True" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- 底部：日志 -->
        <GroupBox Header="日志" Grid.Row="2">
            <TextBox Text="{Binding LogText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />
        </GroupBox>
    </Grid>
</Window>